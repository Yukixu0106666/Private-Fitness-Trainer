# 复制为 .env 后填写。不要把 .env 提交到 git。
OPENAI_API_KEY=gsk-your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
PORT=8000
# Render/Supabase PostgreSQL connection string (leave blank for local SQLite)
DATABASE_URL=
# Set true when serving over HTTPS (Render)
COOKIE_SECURE=true

# Optional semantic retrieval (requires PostgreSQL/Supabase with pgvector)
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional cost estimation, in USD per 1M tokens. Keep these aligned with your provider.
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=
EMBEDDING_COST_PER_1M=
